<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Bluetooth: verbinden met een reeds gekoppeld (bonded) apparaat -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <!-- Oudere Android-versies (<12) gebruiken deze klassieke permissies i.p.v.
         BLUETOOTH_CONNECT/SCAN, en vereisen ze om bv. bondedDevices() te mogen
         aanroepen (anders volgt een SecurityException/crash) -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!-- Oudere Android-versies (<12) hebben FINE_LOCATION nodig voor BLE -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <!-- Foreground service: BLE-verbinding blijft actief op de achtergrond -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- WifiLock (HrBridgeService): houdt de Wi-Fi-radio uit powersave
         zolang de service draait, zodat een TWEEDE telefoon op hetzelfde
         LAN de embedded HTTP-server (HrHttpServer) betrouwbaar kan
         bereiken ook als het scherm van deze telefoon uit staat. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Wegschrijven naar gedeelde opslag, leesbaar voor Termux -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- Op Android 10 en ouder (bv. Android 9) bestaat "Alle bestanden"-toegang
         nog niet; daar is de klassieke runtime-permissie nodig om buiten de
         eigen app-map te mogen schrijven. maxSdkVersion=29 zorgt dat dit op
         Android 11+ genegeerd wordt (daar regelt MANAGE_EXTERNAL_STORAGE het). -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- Optioneel: service automatisch herstarten na een reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Embedded HTTP-server (HrHttpServer, vervangt hr_sync_server.py):
         nodig om een ServerSocket te mogen openen/luisteren. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".HrBridgeApp"
        android:label="HR BLE Bridge"
        android:icon="@android:drawable/ic_dialog_info"
        android:theme="@style/Theme.Material3.DayNight.NoActionBar"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".HrBridgeService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
